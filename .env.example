# Base URL of the OpenAI-compatible LLM API
LLM_BASE_URL=https://api.deepseek.com
# API key for the LLM provider (set it only in .env)
LLM_API_KEY=your-api-key-here
# Model name sent to the LLM API
LLM_MODEL=deepseek-flash
# The agent's "now" (ISO 8601), fixed for reproducibility; 2026-03-25 is a Wednesday
REFERENCE_DATETIME=2026-03-25T10:00
